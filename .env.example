# Optional live amoCRM import. Demo runs without any environment variables.
# Provide the subdomain only: your-account, not a URL.
AMO_SUBDOMAIN=
AMO_ACCESS_TOKEN=

# Optional explicit ASR / LLM commands. Never expose these values in dist/.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# This file is a reference: the stdlib CLI does not auto-load .env files.
